{
  "name": "humidifier-console",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "bootstrap": "node scripts/tasks.mjs bootstrap",
    "dev": "node scripts/tasks.mjs dev",
    "codegen": "node scripts/tasks.mjs codegen",
    "check": "node scripts/tasks.mjs check",
    "db:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait postgres",
    "test:e2e": "node scripts/tasks.mjs e2e"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0"
  }
}
