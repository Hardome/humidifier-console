{
  "name": "@humidifier/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "check": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build",
    "codegen": "kubb generate",
    "lint:biome": "biome check . --no-errors-on-unmatched",
    "lint:eslint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fsd": "steiger ./src",
    "lint:spell": "cspell --no-progress --config ../cspell.config.yaml \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,js,json}\"",
    "lint": "corepack pnpm run lint:biome && corepack pnpm run lint:eslint && corepack pnpm run lint:styles && corepack pnpm run lint:fsd && corepack pnpm run lint:spell",
    "lint:fix": "biome check --write --unsafe . --no-errors-on-unmatched && eslint --flag unstable_native_nodejs_ts_config . --fix --max-warnings=0 && stylelint \"src/**/*.css\" --fix",
    "format": "biome format --write . --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "chart.js": "4.6.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@cspell/dict-ru_ru": "2.3.4",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@kubb/plugin-fetch": "5.13.0",
    "@kubb/plugin-react-query": "5.9.1",
    "@kubb/plugin-ts": "5.4.1",
    "@kubb/plugin-zod": "5.8.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "kubb": "5.16.0",
    "steiger": "0.9.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
